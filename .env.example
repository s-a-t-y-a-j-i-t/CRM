# =============================================================================
# PATRI CMO — Environment Configuration
# Copy this file to .env.local and fill in values from the Firebase console.
# Never commit .env.local or service-account JSON files.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_NAME=PATRI CMO
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=Patri Pharmaceutical Manufacturing

# --- Firebase Client SDK (safe to expose; restricted by Firebase rules) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_) ---
# Option A: path to a local service-account JSON (development only)
FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=

# Option B: inline credentials (preferred for Vercel)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Session cookies ---
# HMAC secret used to sign the session cookie name/flags locally.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=patri_cmo_session
SESSION_COOKIE_MAX_AGE_DAYS=5

# --- Seed / demo ---
# Demo mode is also implied when Firebase public config is incomplete.
NEXT_PUBLIC_DEMO_MODE=false
# Set to true only in development to allow the seed script.
ALLOW_SEED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
